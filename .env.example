# =====================================================================
# Social Media OSINT Configuration
# =====================================================================

# --- YouTube Data API v3 (Recommended for fastest & most complete metrics) ---
# Obtain free from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Note: The tool also features an automatic fallback extractor (yt-dlp) if left empty!
YOUTUBE_API_KEY=

# --- Instagram Credentials (Optional) ---
# Only needed if you encounter rate limits or need to inspect private accounts you follow.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- OSINT Engine Defaults ---
# Maximum videos to fetch per channel in deep scans (default: 200)
DEFAULT_MAX_VIDEOS=500

# Output directory for exported reports (CSV, JSON, SQLite)
OUTPUT_DIR=data

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
